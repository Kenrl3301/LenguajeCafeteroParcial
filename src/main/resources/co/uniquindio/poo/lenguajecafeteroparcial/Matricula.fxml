<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.poo.lenguajecafeteroparcial.controller.MatriculaController">

    <children>

        <!-- TITULO -->

        <Label layoutX="310.0"
               layoutY="20.0"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"
               text="GESTIÓN DE MATRÍCULAS" />


        <!-- PANEL NUEVA MATRÍCULA -->

        <VBox layoutX="30.0"
              layoutY="70.0"
              prefWidth="400.0"
              spacing="10.0">

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;"
                   text="NUEVA MATRÍCULA"
                   underline="true" />

            <TextField fx:id="txtIdEstudiante"
                       promptText="ID del Estudiante" />

            <ComboBox fx:id="cbCursoMatricula"
                      prefWidth="400.0"
                      promptText="Seleccione el curso" />

            <DatePicker fx:id="dpFechaInicio"
                        prefWidth="400.0"
                        promptText="Fecha de Inicio" />

            <DatePicker fx:id="dpFechaFin"
                        prefWidth="400.0"
                        promptText="Fecha de Fin" />

            <TextField fx:id="txtDescuento"
                       promptText="Porcentaje de Descuento" />

            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;"
                   text="Servicios Adicionales" />

            <HBox spacing="10.0">

                <ComboBox fx:id="cbServicios"
                          prefWidth="300.0"
                          promptText="Seleccione un servicio" />

                <Button onAction="#agregarServicioAMatricula"
                        text="Agregar" />

            </HBox>

            <TextArea fx:id="txtAreaServiciosSeleccionados"
                      editable="false"
                      prefHeight="100.0"
                      promptText="Servicios seleccionados..." />

            <Button onAction="#registrarMatricula"
                    prefWidth="400.0"
                    style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Guardar Matrícula" />

        </VBox>


        <!-- PANEL REPORTE DE INGRESOS -->

        <VBox layoutX="500.0"
              layoutY="70.0"
              prefWidth="350.0"
              spacing="10.0">

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;"
                   text="REPORTE DE INGRESOS"
                   underline="true" />

            <Label text="Rango de fechas:" />

            <DatePicker fx:id="dpFechaInicialBusqueda"
                        prefWidth="350.0"
                        promptText="Fecha Inicial" />

            <DatePicker fx:id="dpFechaFinalBusqueda"
                        prefWidth="350.0"
                        promptText="Fecha Final" />

            <Button onAction="#calcularIngresos"
                    prefWidth="350.0"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Calcular Ingresos" />

            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;"
                   text="Total de Ingresos:" />

            <TextField fx:id="txtTotalIngresos"
                       editable="false"
                       prefWidth="350.0"
                       promptText="Total de ingresos" />

        </VBox>


        <!-- BOTON VOLVER -->

        <Button layoutX="30.0"
                layoutY="590.0"
                onAction="#volverMenuPrincipal"
                style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;"
                text="Volver al Menú Principal" />

    </children>

</AnchorPane>